# ------------------------------------------------------------------
# Timi's Jewels — environment
# Copy to `.env` for local dev; the defaults below are enough to run locally.
# PRODUCTION values are set in the Vercel dashboard (Project → Settings →
# Environment Variables), NOT in this file. See README "Deploy to Vercel".
# ------------------------------------------------------------------

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Database — local PostgreSQL (see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/timis_jewels?schema=public"

# Auth (BetterAuth)
BETTER_AUTH_SECRET="dev-only-insecure-secret-change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Seed accounts
ADMIN_EMAIL="admin@timisjewels.local"
ADMIN_PASSWORD="changeme123"

# Paystack — from dashboard.paystack.com → Settings → API Keys & Webhooks.
# Use the TEST keys (sk_test_… / pk_test_…) to try checkout without real charges;
# both must be set for checkout to switch on. Leave WEBHOOK_SECRET blank — Paystack
# signs webhooks with the secret key and the route falls back to it.
# Webhook URL to register in the dashboard: <NEXT_PUBLIC_SITE_URL>/api/webhooks/paystack
# (on localhost, /checkout/callback verifies the payment; the webhook needs a tunnel).
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# SMTP — leave blank locally (emails log to console)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Timi's Jewels <no-reply@timisjewels.com>"

# Cloudflare Images / R2 — leave blank locally (local /public images used)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_IMAGES_TOKEN=""
R2_BUCKET=""

# Vercel Blob — media-library uploads stream here when set. Vercel injects this
# automatically once you connect a Blob store (Project → Storage → Blob).
# For local dev against Blob: `vercel env pull`. Blank = uploads go to /public/uploads.
BLOB_READ_WRITE_TOKEN=""

# Google OAuth - blank = "Continue with Google" button is disabled
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
